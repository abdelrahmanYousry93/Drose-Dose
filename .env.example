# Copy to .env and fill in. Never commit .env.

# Local SQL Server (docker-compose). Must meet SQL Server password complexity rules.
DOSE_SQL_SA_PASSWORD=

# API connection string (environment variable overrides appsettings.json)
ConnectionStrings__Dose=Server=localhost,1433;Database=Dose;User Id=sa;Password=<same as above>;TrustServerCertificate=True

# Public settings (non-secret, but configurable per environment)
Public__WhatsAppBusinessNumber=+201009160638
Public__BusinessTimeZone=Africa/Cairo
